# cpu mask
CONFIG_LITTLE_CPU_MASK=15
CONFIG_BIG_CPU_MASK=112
CONFIG_PRIME_CPU_MASK=128

# cpu assist
CONFIG_CPUSET_ASSIST=y
CONFIG_CPUSET_BG="0-1"
CONFIG_CPUSET_CAMERA="0-3,6-7"
CONFIG_CPUSET_FG="0-3,5-6"
CONFIG_CPUSET_RESTRICTED="0-3"

# stune assist
CONFIG_STUNE_ASSIST=y

# pelt
CONFIG_SCHED_WALT=n
CONFIG_SCHED_CORE_CTL=n
CONFIG_CPU_BOOST=n
CONFIG_PELT_UTIL_HALFLIFE_16=y
CONFIG_SCHEDUTIL_UP_RATE_LIMIT=500
CONFIG_SCHEDUTIL_DOWN_RATE_LIMIT=20000
